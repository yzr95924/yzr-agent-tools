#compdef model-switch
# zsh completion for model-switch(1)
#
# Dynamic model references come from the hidden `model-switch _complete
# models` plumbing command, so completion always reflects the real
# models.toml registry.
#
# scripts/model-switch.sh install symlinks this file into ~/.zfunc/ (added to
# fpath by the ~/.zshrc marker block). Structure: top-level command, then for
# `model` a second-level action, then per-action flags/positionals — each
# level uses `_arguments -C '->state'` so words/CURRENT are re-based per
# level (words[1] = the word just consumed by the previous level).

local curcontext="$curcontext" state line context
typeset -A opt_args

local -a commands actions
commands=(
  'model:Manage model definitions'
  'status:Show the current OpenCode state'
)
actions=(
  'add:Add or replace a model'
  'list:List all configured models'
  'show:Show one model as JSON'
  'remove:Remove a model'
  'use:Activate a model'
  'align:Align model fields with OpenCode catalog cache'
)

local -a _ms_models
_ms_models=(${(f)"$(model-switch _complete models 2>/dev/null)"})

_arguments -C \
  '1:command:->command' \
  '*::arg:->args'

case $state in
  command)
    _describe -t commands 'model-switch command' commands
    ;;
  args)
    case $words[1] in
      status)
        _arguments \
          '(-h --help)'{-h,--help}'[Show help]'
        ;;
      model)
        _arguments -C \
          '1:action:->action' \
          '*::arg:->model-args'
        case $state in
          action)
            _describe -t actions 'model action' actions
            ;;
          model-args)
            case $words[1] in
              add)
                _arguments \
                  '--api-key[API key (stored plaintext in models.toml)]:key:_message -r "key"' \
                  '--catalog-provider[Pin the built-in provider a new yzr-* group inherits from]:provider:_message -r "provider"' \
                  '(-y --yes)'{-y,--yes}'[Assume yes: skip confirmation and overwrite]' \
                  '(-h --help)'{-h,--help}'[Show help]' \
                  ':model reference (yzr-provider/model):_message -r "yzr-provider/model"'
                ;;
              list)
                _arguments '(-h --help)'{-h,--help}'[Show help]'
                ;;
              show)
                _arguments \
                  '(-h --help)'{-h,--help}'[Show help]' \
                  ':model:($_ms_models)'
                ;;
              remove)
                _arguments \
                  '(-y --yes)'{-y,--yes}'[Skip the removal confirmation]' \
                  '(-h --help)'{-h,--help}'[Show help]' \
                  ':model:($_ms_models)'
                ;;
              use)
                _arguments \
                  '(-h --help)'{-h,--help}'[Show help]' \
                  ':model:($_ms_models)'
                ;;
              align)
                _arguments \
                  '(-h --help)'{-h,--help}'[Show help]' \
                  '::model:($_ms_models)'
                ;;
            esac
            ;;
        esac
        ;;
    esac
    ;;
esac
