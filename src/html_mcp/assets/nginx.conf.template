# Generated by `html-mcp nginx-config`. Review, edit, and install.
#
# public_base_url: {{PUBLIC_BASE_URL}}
# docroot:         {{DOCROOT}}
# daemon port:     {{PORT}}
#
# Suggested install:
#   sudo cp this.conf /etc/nginx/sites-available/notes.conf
#   sudo ln -s /etc/nginx/sites-available/notes.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# BEFORE installing, edit the marked TODO lines below:
#   - server_name (set to your FQDN)
#   - ssl_certificate / ssl_certificate_key (Let's Encrypt or your own)
#   - the `alias` line's trailing slash is required for `/files/` to work
#     correctly with sub-paths.

server {
    listen 443 ssl http2;
    server_name notes.example.com;  # TODO: replace with your FQDN

    ssl_certificate     /etc/letsencrypt/live/notes.example.com/fullchain.pem;  # TODO
    ssl_certificate_key /etc/letsencrypt/live/notes.example.com/privkey.pem;  # TODO

    # Public read-only access to uploaded HTML notes.
    # The trailing slash on `alias` matches the trailing slash in this
    # `location`, which is what makes /files/design.html resolve to
    # {{DOCROOT}}/design.html instead of {{DOCROOT}}design.html.
    location /files/ {
        alias {{DOCROOT}}/;
        try_files $uri $uri/ =404;
    }

    # Reverse-proxy the daemon (listens on localhost only — this proxy
    # is what makes it reachable from the public internet).
    location /mcp {
        proxy_pass http://127.0.0.1:{{PORT}}/mcp;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;          # required for MCP streaming
        proxy_read_timeout 86400;
    }

    # JSON API (used by the management page in the browser).
    location /api/ {
        proxy_pass http://127.0.0.1:{{PORT}}/api/;
        proxy_set_header Host $host;
    }

    # Management page (served by the daemon).
    location / {
        proxy_pass http://127.0.0.1:{{PORT}};
        proxy_set_header Host $host;
    }
}