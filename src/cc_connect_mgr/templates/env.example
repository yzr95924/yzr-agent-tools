# cc-connect daemon secrets. chmod 600. Never commit this file.
#
# ONE BOT PER HOST: two daemons polling the same TELEGRAM_BOT_TOKEN will
# steal Telegram updates from each other (getUpdates conflict). Create a
# separate bot per machine via BotFather.
TELEGRAM_BOT_TOKEN=

# Optional DingTalk (stream mode) — referenced from config.toml via
# ${DINGTALK_CLIENT_ID} / ${DINGTALK_CLIENT_SECRET} placeholders.
#DINGTALK_CLIENT_ID=
#DINGTALK_CLIENT_SECRET=
