# llmw-connect config for the llmw agent (generated by llmw-connect-mgr).
# Secrets stay OUT of this file: platforms reference ${ENV} placeholders
# resolved from the daemon's EnvironmentFile (~/.cc-connect/env).

data_dir = ""
attachment_send = ""
language = "zh"
max_attachment_size_mb = 0

[[projects]]
  name = "llmw"
  # Fork-tuned hide list: only commands meaningful for the llmw pane agent
  # stay in the IM menu (the /llmw_* set + /model /mode /compress /help).
  # Upstream may add built-ins that reappear in the menu — re-check this
  # list after upgrading llmw-connect.
  disabled_commands = ["switch", "list", "name", "current", "status", "usage", "history", "allow", "reasoning", "lang", "quiet", "provider", "memory", "cron", "timer", "heartbeat", "stop", "cancel", "version", "commands", "skills", "config", "doctor", "upgrade", "restart", "alias", "delete", "bind", "search", "shell", "show", "dir", "tts", "workspace", "whoami", "web", "diff", "ps", "new"]

  [projects.agent]
    type = "llmw"

    [projects.agent.options]
      backend = "opencode"
      # model = "your-opencode-model-id"   # omit → opencode's default

  [[projects.platforms]]
    type = "telegram"

    [projects.platforms.options]
      allow_from = "*"                      # tighten to your TG user id
      token = "${TELEGRAM_BOT_TOKEN}"

{DINGTALK_BLOCK}
[log]
  level = "info"
